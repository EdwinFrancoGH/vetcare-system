# Dirección del backend (IP de tu computadora en la red local)
EXPO_PUBLIC_API_URL=http://192.168.1.135:5000

# Login con Google (Expo Go)
# Firebase Console > Authentication > Método de acceso > Google > "Configuración del SDK web" > ID de cliente web
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Página puente publicada en la web (opcional, este es el valor por defecto)
EXPO_PUBLIC_GOOGLE_REDIRECT_URL=https://vetcare-system.vercel.app/auth/google-mobile.html
