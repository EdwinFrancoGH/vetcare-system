# Copia este archivo a ".env" y ajusta los valores.
PORT=5000

# El backend espera el archivo de credenciales de Firebase Admin en:
#   backend/credentials/firebase-key.json
# (ruta relativa usada por src/config/firebase.js: "../../credentials/firebase-key.json")

# --- Envío de facturas por correo (módulo de Ventas) ---
# Opcional: si dejas esto vacío, las ventas se registran igual, solo que
# no se envía la factura por correo (se avisa en la consola del
# servidor). Sirve cualquier proveedor SMTP (Gmail, Outlook, un
# proveedor transaccional como Brevo/SendGrid/Mailgun, etc.).
#
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=tuclinica@gmail.com, SMTP_PASS=una "contraseña de aplicación"
# (no la contraseña normal de la cuenta: Gmail no permite usarla
# directamente para esto; se genera en la configuración de seguridad de
# la cuenta de Google, con la verificación en 2 pasos activada).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente que verá el cliente. Si lo dejas vacío, se usa SMTP_USER.
SMTP_FROM=
